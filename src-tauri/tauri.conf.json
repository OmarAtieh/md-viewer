{
  "productName": "Markdown Viewer",
  "version": "0.1.0",
  "identifier": "com.mdviewer.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Markdown Viewer",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: asset:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "name": "Markdown",
        "description": "Markdown file",
        "ext": ["md", "markdown", "mdown"],
        "mimeType": "text/markdown"
      },
      {
        "name": "Text",
        "description": "Plain text file",
        "ext": ["txt", "text", "log"],
        "mimeType": "text/plain"
      }
    ]
  }
}
